# ===================================================================
# NDCMS - Git Ignore Rules for Production & Security
# ===================================================================

# Environment variables, Secrets, and Local configs (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Local KeyStores, Certificates, and Cryptographic Vaults
*.p12
*.jks
*.key
*.pem
*.crt
*.cert
storage_vault/
backend/storage_vault/
backend/src/main/resources/keystore/
pki/

# Archive files & compressed bundles
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
forsic-case-management.zip

# Database files & caches
*.mv.db
*.trace.db
*.db
*.sqlite
*.sqlite3

# Build outputs & dependencies - Backend (Maven/Java)
backend/target/
backend/.mvn/wrapper/
target/
*.class
*.jar
*.war
*.ear

# Build outputs & dependencies - Frontend (Node/Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs & temporary files
*.log
*.tmp
logs/
*.swp
*.swo
*~
*.lnk

# Operating System & IDE files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sublime-workspace
.gemini/
scratch/
