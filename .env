# ==============================================================================
# SIH 190 — Secure Digital Case Management System Environment Configuration
# ==============================================================================
# IMPORTANT: Generate unique random secrets for production using:
#   openssl rand -base64 32
# DO NOT COMMIT THE ACTIVE .env FILE INTO VERSION CONTROL.
# ==============================================================================

# Application Profile (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Configuration
POSTGRES_DB=sih190_db
POSTGRES_USER=sih190_user
# Generate a strong DB password:
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_POSTGRES_PWD_987654

# Redis Cache & Token Revocation Configuration
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION_REDIS_PWD_123456

# MinIO / AWS S3 Encrypted Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION_MINIO_SECRET_987654
S3_BUCKET_NAME=sih190-evidence-vault
S3_QUARANTINE_BUCKET_NAME=sih190-quarantine-vault

# ClamAV Anti-Malware Daemon
CLAMAV_ENABLED=true
CLAMAV_FAIL_CLOSED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Elasticsearch Analytics
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_ENABLED=true

# Cryptographic Master Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_AUDIENCE=sih190-api
KMS_MASTER_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=
PKI_KEYSTORE_PASSWORD=CHANGE_ME_IN_PRODUCTION_PKI_PWD_2026

# Server & Port Configuration
SERVER_PORT=8080
FRONTEND_PORT=3000
