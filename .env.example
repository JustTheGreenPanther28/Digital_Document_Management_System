# ==============================================================================
# FORSIC — .env.example  (SAFE TO COMMIT — contains NO real secrets)
# ==============================================================================
# Copy this file to .env and fill in real values for local dev.
# For production on OCI VM: secrets are stored in OCI Vault and injected
# at deploy time by deploy/fetch-oci-vault-secrets.sh
#
# Generate strong secrets with:
#   openssl rand -base64 32    (for passwords and KMS key)
#   openssl rand -hex 32       (for JWT secret)
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL ---
POSTGRES_DB=sih190_db
POSTGRES_USER=sih190_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Redis ---
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- MinIO Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
S3_BUCKET_NAME=sih190-evidence-vault
S3_QUARANTINE_BUCKET_NAME=sih190-quarantine-vault

# --- ClamAV Anti-Malware ---
CLAMAV_ENABLED=true
CLAMAV_FAIL_CLOSED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_ENABLED=true

# --- Cryptographic Secrets (CRITICAL — generate unique values per deployment) ---
# JWT_SECRET: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_GENERATED_BY_OPENSSL
JWT_AUDIENCE=sih190-api
# KMS_MASTER_KEY: openssl rand -base64 32
KMS_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES_GENERATED_BY_OPENSSL
PKI_KEYSTORE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Server Ports ---
SERVER_PORT=8080
FRONTEND_PORT=3000
